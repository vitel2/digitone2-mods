{
 "id": "lfo-preset-shuffle",
 "version": "1.0",
 "title": "LFO preset shuffle (POOL)",
 "category": "Sequencer",
 "author": "Vijay",
 "license": "GPL-2.0-or-later",
 "description": "Adds a destination, PRST > Preset Pool (POOL), to synth-track LFO1-3. Point an LFO at POOL with DEP above 0 and each sequencer trig without a manual preset lock plays a preset-pool slot picked from the LFO's wave (SPD, MULT, WAVE, SPH; the phase moves per step). DEP sets how many of the filled pool slots are used: at full depth, all of them. The middle of the wave's swing plays the track's own sound. Negative DEP mirrors the order. MIDI tracks are not affected.",
 "device": "digitone-mk2",
 "os": "1.12",
 "sources": [
  "shuffle.s"
 ],
